    [$Z^((k))_d$], [问题 $k$（$k=1,2$）下第 $d$ 日的工人总数], [人],
    [$L_d$], [第 $d$ 日的工人数理论下界], [人],
    [$N$], [问题三月度招工总数], [人],
    [$w_(i,d)$], [工人 $i$ 在第 $d$ 日是否出勤], [0/1],
