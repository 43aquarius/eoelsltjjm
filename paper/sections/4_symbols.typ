  font: ("Heiti SC", "STHeiti", "SimSun", "Songti SC"),
  size: 12pt,
)[表 1 #h(1em) 主要符号说明]]
#align(center)[
  #table(
    columns: (5em, 22em, 6em),
    align: (center, left, center),
    stroke: none,
    inset: (x: 0.6em, y: 0.5em),
    table.hline(stroke: 0.8pt),
    [#strong[符号]], [#strong[含义]], [#strong[类型/单位]],
