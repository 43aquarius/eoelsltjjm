<mxfile host="app.diagrams.net">
  <diagram name="问题二求解流程" id="flowq2">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" page="1" pageWidth="850" pageHeight="900">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="问题二求解流程：MILP + 班内低产能小时" style="text;html=1;align=center;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="370" y="70" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="读取 v_{d,h} 与 Shift(s)（模 24）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="290" y="140" width="270" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="对每日 d ∈ {1..30}：&#10;构造 PuLP MILP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="290" y="200" width="270" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="决策变量&#10;ξ_s ∈ Z+（24）；δ_s ∈ {0,1}（24）；&#10;y_{s,h} ≥ 0 连续（仅 h ∈ Shift(s)）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="290" y="280" width="270" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="约束&#10;∑δ = 5  (恰 5 起点)&#10;∑_{h∈Shift(s)} y_{s,h} = ξ_s&#10;累计 Cap_h ≥ 累计 v_h ∀H" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="290" y="370" width="270" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="Cap_h 公式&#10;25·∑_s A_{s,h} ξ_s − 15·∑_s y_{s,h}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="290" y="470" width="270" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="CBC 求解（threads=2, timeLimit=30s）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="290" y="550" width="270" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="校验：&#10;CumCap_{15} ≥ CumArr_{11} (D3)&#10;CumCap_{23} ≥ CumArr_{23} (D4)&#10;Z(2)_d ≥ Z(1)_d 单调性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="290" y="620" width="270" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="d &lt; 30？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="335" y="720" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="导出 q2_solution.json&#10;含 ξ, y, starts, Z_per_day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="290" y="800" width="270" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=classic" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=classic" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="是" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic" edge="1" parent="1" source="n9" target="n3">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="750"/><mxPoint x="180" y="230"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e10" value="否" style="endArrow=classic" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
