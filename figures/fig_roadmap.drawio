        <mxCell id="data" value="附件 1&#10;30天×24小时进货量 v_{d,h}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
