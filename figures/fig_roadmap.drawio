          <mxGeometry x="60" y="290" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="问题一&#10;每日 MILP（枚举 C(24,5)）&#10;min ∑ξ_s&#10;s.t. 累计产能 ≥ 累计进货" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="问题二&#10;在 Q1 基础上加&#10;1) 16 点截止&#10;2) 班内 1 小时低产能 y_{s,h}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="问题三&#10;模式生成 + LP松弛 + MILP 精化&#10;min N&#10;每人 23 工作日，≤7 连工" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="380" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="result" value="结果汇总&#10;Z(1)=10791  Z(2)=11668  N=581&#10;均达理论下界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="240" width="240" height="80" as="geometry" />
