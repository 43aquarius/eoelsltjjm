<mxfile host="app.diagrams.net">
  <diagram name="模型结构与变量关系" id="model">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="模型变量与约束关系" style="text;html=1;align=center;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="输入&#10;v_{d,h}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="delta" value="δ_s ∈ {0,1}&#10;起点是否选用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="240" y="100" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="xi" value="ξ_{d,s} ∈ Z+&#10;每日每起点工人数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="240" y="280" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="y" value="y_{d,s,h} ≥ 0&#10;班内低产能小时分配" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="240" y="460" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="W" value="W_{d,h} = ∑_s A_{s,h} ξ_{d,s}&#10;小时在岗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="480" y="200" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cap" value="Cap_{d,h}&#10;= 25·W_{d,h} − 15·∑_s y_{d,s,h}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="480" y="370" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="con1" value="∑_s δ_s = 5 (Q2 严格 5 起点)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="720" y="100" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="con2" value="ξ_{d,s} ≤ M·δ_s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="720" y="160" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="con3" value="∑_{h∈Shift(s)} y_{d,s,h} = ξ_{d,s}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="720" y="460" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="con4" value="∑_{h≤H} Cap_{d,h} ≥ ∑_{h≤H} v_{d,h}&#10;∀H ∈ {0..23} (D2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="720" y="370" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="obj" value="目标&#10;Q1/Q2: min ∑_{d,s} ξ_{d,s}&#10;Q3: min N (合法模式覆盖)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="720" y="580" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;dashed=1" edge="1" parent="1" source="input" target="xi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic" edge="1" parent="1" source="delta" target="xi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic" edge="1" parent="1" source="xi" target="W"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic" edge="1" parent="1" source="xi" target="y"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic" edge="1" parent="1" source="W" target="cap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic" edge="1" parent="1" source="y" target="cap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic" edge="1" parent="1" source="cap" target="con4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=classic" edge="1" parent="1" source="delta" target="con1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=classic" edge="1" parent="1" source="delta" target="con2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="endArrow=classic" edge="1" parent="1" source="y" target="con3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="endArrow=classic;dashed=1" edge="1" parent="1" source="input" target="cap">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="400"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
